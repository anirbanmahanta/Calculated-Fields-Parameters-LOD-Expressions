      <aliases enabled='yes' />
      <column caption='Delivery Performance Classification' datatype='string' name='[Calculation_0561640260710400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt; 30 THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit %' datatype='real' name='[Calculation_0561640262311937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Loss-Making Orders' datatype='string' name='[Calculation_0561640263024642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSE &quot;Profit&quot;&#13;&#10;END' />
      </column>
      <column caption='Rank product' datatype='integer' name='[Calculation_0561640270942222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_0561640271343637]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0561640270942222] &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fixed LOD' datatype='integer' name='[Calculation_0561640273924122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Sales]) }' />
      </column>
      <column caption='Avg Sales at Product Level' datatype='real' name='[Calculation_0561640276520987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [Product_Name]: SUM([Sales]) })' />
      </column>
